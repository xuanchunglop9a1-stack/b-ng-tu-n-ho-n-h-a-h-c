    const elements = raw.map(([number, symbol, name, period, group, category, mass, config]) => ({
      number, symbol, name, period, group, category, mass, config,
      protons: number,
      electrons: number,
      neutrons: Math.max(0, Math.round(mass) - number),
      state: number === 1 || ["N","O","F","Cl"].includes(symbol) || category === "noble" ? "Khí" : ["Br","Hg"].includes(symbol) ? "Lỏng" : "Rắn",
      electronegativity: category === "noble" ? "Không xác định" : (0.7 + (group / 18) * 3.2).toFixed(2),
      melt: category === "noble" ? "Rất thấp" : "Thay đổi theo nguyên tố",
      boil: category === "noble" ? "Rất thấp" : "Thay đổi theo nguyên tố",
      density: "Dữ liệu mở rộng",
      uses: "Học tập, công nghiệp, vật liệu, y sinh hoặc nghiên cứu tùy từng nguyên tố.",
      history: "Thông tin lịch sử phát hiện có thể nối với cơ sở dữ liệu chi tiết trong bản backend.",
      toxicity: category === "actinide" ? "Phóng xạ, cần kiểm soát nghiêm ngặt" : "Phụ thuộc dạng chất và nồng độ",
      bio: ["C","H","O","N","P","S","Na","K","Ca","Mg","Fe","Cl"].includes(symbol) ? "Có vai trò sinh học quan trọng" : "Vai trò sinh học hạn chế hoặc chưa rõ"
    }));

    const timelineData = [
      ["1803","Dalton","Đề xuất thuyết nguyên tử hiện đại, xem nguyên tử là hạt cơ bản của chất."],
      ["1817","Döbereiner","Phát hiện bộ ba nguyên tố có tính chất gần nhau."],
      ["1862","Chancourtois","Sắp xếp nguyên tố theo hình xoắn ốc telluric."],
      ["1864","Newlands","Đưa ra quy luật bát âm khi xếp theo khối lượng nguyên tử."],
      ["1869","Mendeleev","Công bố bảng tuần hoàn và dự đoán nguyên tố chưa phát hiện."],
      ["1913","Moseley","Dùng số hiệu nguyên tử làm trật tự nền tảng."],
      ["1945","Seaborg","Đề xuất dãy actini, định hình bảng hiện đại."],
      ["Hiện đại","IUPAC","Chuẩn hóa tên gọi, ký hiệu và công nhận nguyên tố mới."]
    ];

    const table = document.getElementById("periodicTable");
    const selected = { current: elements[0] };

    function renderTimeline() {
      document.getElementById("timeline").innerHTML = timelineData.map(item => `
        <article class="panel pad time-card"><strong>${item[0]}</strong><h3>${item[1]}</h3><p class="muted">${item[2]}</p></article>
      `).join("");
    }

    function renderLegend() {
      document.getElementById("legend").innerHTML = Object.entries(categories).map(([key, label]) => `
        <span class="legend-item"><span class="swatch ${key}"></span>${label}</span>
      `).join("");
    }

    function renderFilters() {
      const periodFilter = document.getElementById("periodFilter");
      const groupFilter = document.getElementById("groupFilter");
      for (let i = 1; i <= 9; i++) periodFilter.insertAdjacentHTML("beforeend", `<option value="${i}">${i <= 7 ? "Chu kỳ " + i : i === 8 ? "Dãy Lantan" : "Dãy Actini"}</option>`);
      for (let i = 1; i <= 18; i++) groupFilter.insertAdjacentHTML("beforeend", `<option value="${i}">Nhóm ${i}</option>`);
    }

    function renderTable() {
      table.innerHTML = "";
      elements.forEach(el => {
        const cell = document.createElement("button");
        cell.className = `element ${el.category}`;
        cell.style.gridColumn = el.group;
        cell.style.gridRow = el.period;
        cell.title = `${el.name} (${el.symbol}) - ${categories[el.category]}`;
        cell.dataset.category = el.category;
        cell.dataset.period = el.period;
        cell.dataset.group = el.group;
        cell.dataset.search = `${el.name} ${el.symbol} ${el.number} ${categories[el.category]}`.toLowerCase();
        cell.innerHTML = `<div class="num">${el.number}</div><div class="sym">${el.symbol}</div><div class="ename">${el.name}</div><div class="mass">${el.mass}</div>`;
        cell.addEventListener("click", () => {
          selected.current = el;
          renderDetail(el);
          openModal(el);
          document.getElementById("detail").scrollIntoView({ behavior: "smooth", block: "start" });
        });
        table.appendChild(cell);
      });
    }

    function applyFilters() {
      const cat = document.getElementById("categoryFilter").value;
      const period = document.getElementById("periodFilter").value;
      const group = document.getElementById("groupFilter").value;
      const term = document.getElementById("globalSearch").value.trim().toLowerCase();
      document.querySelectorAll(".element").forEach(cell => {
        const passCat = cat === "all" || cell.dataset.category === cat;
        const passPeriod = period === "all" || cell.dataset.period === period;
        const passGroup = group === "all" || cell.dataset.group === group;
        const passTerm = !term || cell.dataset.search.includes(term);
        cell.classList.toggle("dim", !(passCat && passPeriod && passGroup && passTerm));
      });
    }

    function renderDetail(el) {
      document.getElementById("bigSymbol").innerHTML = `<div><b>${el.symbol}</b><span>${el.name}</span><br><small>Số hiệu ${el.number}</small></div>`;
      document.getElementById("detailName").textContent = `${el.name} (${el.symbol})`;
      document.getElementById("detailIntro").textContent = `${el.name} thuộc nhóm ${el.group}, chu kỳ ${el.period <= 7 ? el.period : el.period === 8 ? "Lantan" : "Actini"}, loại ${categories[el.category]}.`;
      document.getElementById("electronConfig").textContent = el.config;
      const data = [
        ["Tên", el.name],["Ký hiệu", el.symbol],["Số hiệu nguyên tử", el.number],["Khối lượng", el.mass],
        ["Proton", el.protons],["Neutron", el.neutrons],["Electron", el.electrons],["Cấu hình electron", el.config],
        ["Độ âm điện", el.electronegativity],["Nhiệt độ nóng chảy", el.melt],["Nhiệt độ sôi", el.boil],["Trạng thái", el.state],
        ["Độ dẫn điện", "Theo pha và cấu trúc"],["Độ dẫn nhiệt", "Theo vật liệu"],["Ứng dụng", el.uses],["Độc tính", el.toxicity],
        ["Vai trò sinh học", el.bio],["Lịch sử phát hiện", el.history]
      ];
      document.getElementById("facts").innerHTML = data.map(([k,v]) => `<div class="fact"><small>${k}</small>${v}</div>`).join("");
    }

    function openModal(el) {
      document.getElementById("modalTitle").textContent = `${el.name} - ${el.symbol}`;
      document.getElementById("modalBody").innerHTML = `
        <div class="detail-layout">
          <div class="big-symbol"><div><b>${el.symbol}</b><span>${el.name}</span><br><small>${categories[el.category]}</small></div></div>
          <div>
            <h2>${el.name}</h2>
            <p class="muted">Chi tiết gồm tên, ký hiệu, số hiệu, khối lượng, electron, neutron, proton, cấu hình electron, độ âm điện, nhiệt độ, màu sắc, khối lượng riêng, trạng thái, ứng dụng, lịch sử, mô hình 3D, video, quiz, phản ứng, điều chế, độc tính và vai trò sinh học.</p>
            <div class="facts">
              <div class="fact"><small>Số hiệu</small>${el.number}</div>
              <div class="fact"><small>Khối lượng</small>${el.mass}</div>
              <div class="fact"><small>Nhóm</small>${el.group}</div>
              <div class="fact"><small>Chu kỳ</small>${el.period}</div>
              <div class="fact"><small>Cấu hình</small>${el.config}</div>
              <div class="fact"><small>Ứng dụng</small>${el.uses}</div>
            </div>
          </div>
        </div>`;
      document.getElementById("elementModal").classList.add("open");
    }

    function populateCompare() {
      const options = elements.map(el => `<option value="${el.number}">${el.symbol} - ${el.name}</option>`).join("");
      document.getElementById("compareA").innerHTML = options;
      document.getElementById("compareB").innerHTML = options;
      document.getElementById("compareB").value = 19;
    }

    function compare() {
      const a = elements.find(el => el.number == document.getElementById("compareA").value);
      const b = elements.find(el => el.number == document.getElementById("compareB").value);
      const rows = [
        ["Nguyên tố", `${a.symbol} - ${a.name}`, `${b.symbol} - ${b.name}`],
        ["Khối lượng", a.mass, b.mass],
        ["Cấu hình", a.config, b.config],
        ["Bán kính", `Ước tính theo chu kỳ ${a.period}`, `Ước tính theo chu kỳ ${b.period}`],
        ["Nhiệt độ sôi", a.boil, b.boil],
        ["Độ âm điện", a.electronegativity, b.electronegativity]
      ];
      document.getElementById("compareResult").innerHTML = rows.map(([k, av, bv]) => `<div class="fact"><small>${k}</small><b>${av}</b><br><span class="muted">${bv}</span></div>`).join("");
    }

    function renderScientists() {
      const names = ["Mendeleev","Moseley","Dalton","Bohr","Rutherford","Thomson","Curie","Einstein"];
      document.getElementById("scientistsList").innerHTML = names.map(name => `<div class="fact"><small>Nhà khoa học</small><b>${name}</b><br><span class="muted">Tiểu sử, đóng góp, hình ảnh và video học tập.</span></div>`).join("");
    }

    function renderGame() {
      const tiles = ["H","Hydrogen","O","Oxygen","Na","Sodium","Cl","Chlorine"];
      document.getElementById("gameBoard").innerHTML = tiles.map(t => `<button class="card-tile">${t}</button>`).join("");
    }

    document.getElementById("themeSelect").addEventListener("change", e => document.body.dataset.theme = e.target.value);
    ["categoryFilter","periodFilter","groupFilter","globalSearch"].forEach(id => document.getElementById(id).addEventListener("input", applyFilters));
    document.getElementById("searchBtn").addEventListener("click", applyFilters);
    document.getElementById("resetFilters").addEventListener("click", () => {
      document.getElementById("categoryFilter").value = "all";
      document.getElementById("periodFilter").value = "all";
      document.getElementById("groupFilter").value = "all";
      document.getElementById("globalSearch").value = "";
      applyFilters();
    });
    document.getElementById("closeModal").addEventListener("click", () => document.getElementById("elementModal").classList.remove("open"));
    document.getElementById("elementModal").addEventListener("click", e => {
      if (e.target.id === "elementModal") e.currentTarget.classList.remove("open");
    });
    document.getElementById("prevElement").addEventListener("click", () => {
      const next = elements[Math.max(0, selected.current.number - 2)];
      selected.current = next;
      renderDetail(next);
    });
    document.getElementById("nextElement").addEventListener("click", () => {
      const next = elements[Math.min(elements.length - 1, selected.current.number)];
      selected.current = next;
      renderDetail(next);
    });
    document.getElementById("compareBtn").addEventListener("click", compare);
    document.querySelectorAll(".quiz-option").forEach(btn => btn.addEventListener("click", () => {
      const ok = btn.dataset.answer === "true";
      document.getElementById("quizStatus").textContent = ok ? "Chính xác! Hydrogen có ký hiệu H." : "Chưa đúng, thử lại nhé.";
      if (ok) {
        document.getElementById("score").textContent = Number(document.getElementById("score").textContent) + 10;
        document.getElementById("xp").textContent = Number(document.getElementById("xp").textContent) + 10;
      }
    }));
    document.getElementById("spinBtn").addEventListener("click", () => {
      const sample = elements[Math.floor(Math.random() * elements.length)];
      alert(`May mắn hôm nay: ${sample.name} (${sample.symbol})`);
    });

    renderTimeline();
    renderLegend();
    renderFilters();
    renderTable();
    renderDetail(elements[0]);
    populateCompare();
    compare();
    renderScientists();
    renderGame();
  </script>
</body>
</html>
